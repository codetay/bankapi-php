{
    "name": "bankapi/bankapi-php",
    "description": "BankAPI.VN PHP SDK — API client and webhook signature verification",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 HTTP client implementation"
    },
    "autoload": {
        "psr-4": { "BankApi\\": "src/" }
    },
    "minimum-stability": "stable"
}
