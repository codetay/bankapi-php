{
    "name": "codetay/bankapi-php",
    "description": "BankAPI.VN PHP SDK — API client and webhook signature verification",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "bankapi",
        "banking",
        "sdk",
        "api-client",
        "webhook",
        "vietnam"
    ],
    "authors": [
        {
            "name": "BANKAPI.VN"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 HTTP client implementation"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "php-http/mock-client": "^1.6",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "BankApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BankApi\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
